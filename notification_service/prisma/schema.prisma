generator client {
    provider="prisma-client-js"
}

datasource db {
    provider="postgresql"
    url=env("DATABASE_URL")
}

model Notification {
    id Int @id @default(autoincrement())
    userId Int
    userEmail String
    productId Int
    productName String
    productImage String?
    productCategory String
    productDescription String?
    type String
    emailedAt DateTime?
    createdAt DateTime @default(now())

    @@unique([userId, productId])
}