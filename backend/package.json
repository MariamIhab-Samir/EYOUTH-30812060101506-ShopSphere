{
  "name": "Lionera-backend",
  "version": "1.0.0",
  "description": "Lionera backend",
  "main": "app.js",
  "type": "commonjs",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "db:pull": "npx prisma db pull",
    "db:generate": "npx prisma generate",
    "db:seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "@supabase/supabase-js": "^2.112.3",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.7.4",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.0.3",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.11.0",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "liscense": "ISC",
  "jest": {
    "testTimeout": 15000,
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "globalTeardown": "<rootDir>/jest.globalTeardown.js"
  }
}
